# Public site origin. The React app reads VITE_SITE_URL.
VITE_SITE_URL=http://localhost:3000

# MySQL, used by the Next.js API.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=bil
MYSQL_PASSWORD=bil
MYSQL_DATABASE=bil

# Inbox that should receive contact and newsletter messages.
CONTACT_EMAIL=

# Verified sender, for example "BIL <hello@your-domain>".
CONTACT_FROM_EMAIL=

# Server-only. Never expose this in client code.
RESEND_API_KEY=

# Signs the admin session cookie. The admin account itself is created by the database seed.
ADMIN_SESSION_SECRET=
